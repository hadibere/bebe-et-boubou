{
  "expo": {
    "name": "bébé&boubou",
    "slug": "bebe-et-boubou",
    "scheme": "bebeetboubou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hadibere.bebeboubou",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "backgroundColor": "#FFF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#34332F"
        }
      ],
      "expo-notifications",
      "react-native-edge-to-edge"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0283cfaa-c664-4fbc-8bd9-69e88a3a6ddd"
      }
    },
    "owner": "hadibere"
  }
}
