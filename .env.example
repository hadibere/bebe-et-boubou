# Configuration Firebase — copie ce fichier vers `.env` et remplis les valeurs.
# Elles se trouvent dans la console Firebase :
#   Paramètres du projet → Vos applications → application Web → firebaseConfig
#
# Ces valeurs ne sont pas des secrets (elles sont embarquées dans l'app livrée),
# mais on évite de les mettre dans l'historique Git. La sécurité réelle vient
# des règles Firestore, dans firestore.rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mets 1 pour taper sur les émulateurs locaux au lieu du vrai projet.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0
